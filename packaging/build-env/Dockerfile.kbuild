# Isolated x86_64 -> aarch64 cross-build environment for M1 (kernel, DTB, modules, uniLoader, lk3rd, mkbootimg)
FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bc \
    binutils-aarch64-linux-gnu \
    bison \
    build-essential \
    ca-certificates \
    cpio \
    device-tree-compiler \
    dwarves \
    file \
    flex \
    g++-aarch64-linux-gnu \
    gcc-aarch64-linux-gnu \
    git \
    gzip \
    kmod \
    libc6-dev-arm64-cross \
    libelf-dev \
    libssl-dev \
    lz4 \
    python3 \
    rsync \
    tar \
    xz-utils \
    zstd \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
