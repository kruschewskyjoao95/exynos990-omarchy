From: Antigravity <antigravity@local>
Subject: [PATCH] regulator: add s2mps22-acpm-regulator for Exynos 990 camera rails

Add an ACPM-backed regulator driver for the secondary S2MPS22 PMIC on
Exynos 990 (SPEEDY channel 1, ACPM IPC channel 2), exposing LDO5S
(VDD_MIPI_CSI_0P85_AP) and LDO6S (VDD_MIPI_CSI_1P8_AP) needed by the
MIPI CSI-2 camera receivers.

Signed-off-by: Antigravity <antigravity@local>
---
 drivers/regulator/Kconfig                |   9 ++
 drivers/regulator/Makefile               |   1 +
 drivers/regulator/s2mps22-acpm-regulator.c | 199 +++++++++++++++++++++
 3 files changed, 209 insertions(+)
 create mode 100644 drivers/regulator/s2mps22-acpm-regulator.c

diff --git a/drivers/regulator/Kconfig b/drivers/regulator/Kconfig
index 000000000..000000000 100644
--- a/drivers/regulator/Kconfig
+++ b/drivers/regulator/Kconfig
@@ -1346,6 +1346,14 @@
 	  is only reachable through the ACPM firmware (mailbox -> APM -> SPEEDY),
 	  so this is the only way to control rails such as VDD_WIFI_0P95 (BUCK4M),
 	  which supplies the PCIe Wi-Fi endpoint.
+
+config REGULATOR_S2MPS22_ACPM
+	tristate "Samsung S2MPS22 PMIC regulators over Exynos ACPM"
+	depends on EXYNOS_ACPM_PROTOCOL
+	help
+	  Say y here to support the secondary S2MPS22 PMIC regulators over the
+	  Exynos ACPM firmware channel (SPEEDY channel 1), including the
+	  MIPI CSI-2 camera power rails (LDO5S / LDO6S).
 
 config REGULATOR_S2MPS11
 	tristate "Samsung S2MPS11/13/14/15/S2MPU02 voltage regulator"
diff --git a/drivers/regulator/Makefile b/drivers/regulator/Makefile
index 000000000..000000000 100644
--- a/drivers/regulator/Makefile
+++ b/drivers/regulator/Makefile
@@ -157,4 +157,5 @@ obj-$(CONFIG_REGULATOR_S2MPA01) += s2mpa01.o
 obj-$(CONFIG_REGULATOR_S2MPS11) += s2mps11.o
 obj-$(CONFIG_REGULATOR_S2MPS19_ACPM) += s2mps19-acpm-regulator.o
+obj-$(CONFIG_REGULATOR_S2MPS22_ACPM) += s2mps22-acpm-regulator.o
 obj-$(CONFIG_REGULATOR_S5M8767) += s5m8767.o
 obj-$(CONFIG_REGULATOR_SC2731) += sc2731-regulator.o
diff --git a/drivers/regulator/s2mps22-acpm-regulator.c b/drivers/regulator/s2mps22-acpm-regulator.c
new file mode 100644
index 000000000..000000000
--- /dev/null
+++ b/drivers/regulator/s2mps22-acpm-regulator.c
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * S2MPS22 secondary PMIC regulators on Exynos 990, driven over ACPM.
+ *
+ * S2MPS22 hangs off the APM coprocessor on SPEEDY channel 1 (ACPM IPC
+ * channel 2) and supplies the MIPI CSI-2 rails (LDO5S = 0.85V, LDO6S = 1.8V)
+ * required by the camera subsystem.
+ */
+
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+#include <linux/regulator/of_regulator.h>
+
+#define S2MPS22_TYPE_PMIC		0x01
+#define S2MPS22_SPEEDY_CHAN		1
+
+/* Enable field is bits [7:6]; opmode 0x3 = on. */
+#define S2MPS22_ENABLE_SHIFT		6
+#define S2MPS22_ENABLE_MASK		(0x03 << S2MPS22_ENABLE_SHIFT)
+#define S2MPS22_ENABLE_ON		(0x03 << S2MPS22_ENABLE_SHIFT)
+
+/* Control registers, from include/linux/mfd/samsung/s2mps22-regulator.h. */
+#define S2MPS22_REG_LDO5S_CTRL		0x2E
+#define S2MPS22_REG_LDO6S_CTRL		0x2F
+
+struct s2mps22_acpm {
+	struct acpm_handle *acpm;
+	unsigned int chan_id;
+	struct device *dev;
+};
+
+static int s2mps22_acpm_enable(struct regulator_dev *rdev)
+{
+	struct s2mps22_acpm *pmic = rdev_get_drvdata(rdev);
+	int ret;
+	u8 val = 0;
+
+	ret = pmic->acpm->ops->pmic.update_reg(pmic->acpm, pmic->chan_id,
+					       S2MPS22_TYPE_PMIC,
+					       rdev->desc->enable_reg,
+					       S2MPS22_SPEEDY_CHAN,
+					       S2MPS22_ENABLE_ON,
+					       S2MPS22_ENABLE_MASK);
+	if (ret)
+		return ret;
+
+	/* Readback to ensure the ACPM transaction completed. */
+	pmic->acpm->ops->pmic.read_reg(pmic->acpm, pmic->chan_id,
+				       S2MPS22_TYPE_PMIC,
+				       rdev->desc->enable_reg,
+				       S2MPS22_SPEEDY_CHAN, &val);
+	return 0;
+}
+
+static int s2mps22_acpm_disable(struct regulator_dev *rdev)
+{
+	struct s2mps22_acpm *pmic = rdev_get_drvdata(rdev);
+
+	return pmic->acpm->ops->pmic.update_reg(pmic->acpm, pmic->chan_id,
+						S2MPS22_TYPE_PMIC,
+						rdev->desc->enable_reg,
+						S2MPS22_SPEEDY_CHAN,
+						0, S2MPS22_ENABLE_MASK);
+}
+
+static int s2mps22_acpm_is_enabled(struct regulator_dev *rdev)
+{
+	struct s2mps22_acpm *pmic = rdev_get_drvdata(rdev);
+	u8 val = 0;
+	int ret;
+
+	ret = pmic->acpm->ops->pmic.read_reg(pmic->acpm, pmic->chan_id,
+					       S2MPS22_TYPE_PMIC,
+					       rdev->desc->enable_reg,
+					       S2MPS22_SPEEDY_CHAN, &val);
+	if (ret)
+		return ret;
+
+	return (val & S2MPS22_ENABLE_MASK) == S2MPS22_ENABLE_ON;
+}
+
+static const struct regulator_ops s2mps22_acpm_ops = {
+	.enable		= s2mps22_acpm_enable,
+	.disable	= s2mps22_acpm_disable,
+	.is_enabled	= s2mps22_acpm_is_enabled,
+};
+
+#define S2MPS22_ACPM_DESC(_name, _of, _reg, _uv)			\
+	{								\
+		.name		= _name,				\
+		.of_match	= of_match_ptr(_of),			\
+		.regulators_node = of_match_ptr("regulators"),		\
+		.id		= 0,					\
+		.ops		= &s2mps22_acpm_ops,			\
+		.type		= REGULATOR_VOLTAGE,			\
+		.owner		= THIS_MODULE,				\
+		.enable_reg	= _reg,					\
+		.enable_mask	= S2MPS22_ENABLE_MASK,			\
+		.n_voltages	= 1,					\
+		.fixed_uV	= _uv,					\
+		.enable_time	= 130,					\
+	}
+
+static const struct regulator_desc s2mps22_acpm_regulators[] = {
+	/* LDO5S = VDD_MIPI_CSI_0P85_AP, LDO6S = VDD_MIPI_CSI_1P8_AP */
+	S2MPS22_ACPM_DESC("LDO5S", "ldo5s", S2MPS22_REG_LDO5S_CTRL, 850000),
+	S2MPS22_ACPM_DESC("LDO6S", "ldo6s", S2MPS22_REG_LDO6S_CTRL, 1800000),
+};
+
+static int s2mps22_acpm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config config = { };
+	struct s2mps22_acpm *pmic;
+	struct device_node *acpm_np;
+	u32 chan_id;
+	int i;
+
+	pmic = devm_kzalloc(dev, sizeof(*pmic), GFP_KERNEL);
+	if (!pmic)
+		return -ENOMEM;
+
+	acpm_np = of_get_parent(dev->of_node);
+	if (!acpm_np)
+		return -ENODEV;
+
+	pmic->acpm = devm_acpm_get_by_node(dev, acpm_np);
+	of_node_put(acpm_np);
+	if (IS_ERR(pmic->acpm))
+		return dev_err_probe(dev, PTR_ERR(pmic->acpm),
+				     "failed to get ACPM handle\n");
+
+	if (of_property_read_u32(dev->of_node, "acpm-ipc-channel", &chan_id))
+		return dev_err_probe(dev, -EINVAL, "missing acpm-ipc-channel\n");
+	pmic->chan_id = chan_id;
+	pmic->dev = dev;
+
+	config.dev = dev;
+	config.driver_data = pmic;
+
+	for (i = 0; i < ARRAY_SIZE(s2mps22_acpm_regulators); i++) {
+		struct regulator_dev *rdev;
+
+		rdev = devm_regulator_register(dev,
+					       &s2mps22_acpm_regulators[i],
+					       &config);
+		if (IS_ERR(rdev))
+			return dev_err_probe(dev, PTR_ERR(rdev),
+					     "failed to register %s\n",
+					     s2mps22_acpm_regulators[i].name);
+	}
+
+	dev_info(dev, "S2MPS22 regulators over ACPM channel %u\n", pmic->chan_id);
+
+	return 0;
+}
+
+static const struct of_device_id s2mps22_acpm_match[] = {
+	{ .compatible = "samsung,s2mps22-acpm-regulator" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s2mps22_acpm_match);
+
+static struct platform_driver s2mps22_acpm_driver = {
+	.driver = {
+		.name = "s2mps22-acpm-regulator",
+		.of_match_table = s2mps22_acpm_match,
+	},
+	.probe = s2mps22_acpm_probe,
+};
+module_platform_driver(s2mps22_acpm_driver);
+
+MODULE_DESCRIPTION("S2MPS22 regulators over Exynos ACPM");
+MODULE_LICENSE("GPL");
-- 
2.47.0
