+	writel(0x3223, state->bias + 8);
+	writel(0x40, state->bias + 0x10);
+
+	/* DCPHY 5.3, C-PHY at 2964 Msps, settle = 7 (7nm LPP). */
+	for (int i = 0; i < 3; i++) {
+		void __iomem *d = state->regs + 0x100 + i * 0x100;
+
+		writel(0x1450, d + 0x04);
+		writel(0x9, d + 0x08);
+		writel(0x82c8, d + 0x0c);
+		writel(0x1, d + 0x10);
+		writel(0x8680, d + 0x14);
+		writel(0x4000, d + 0x18);
+		writel(0x200, d + 0x1c);
+		writel(0x638, d + 0x20);
+		writel(0x40, d + 0x24);
+		writel((readl(d + 0x30) & ~GENMASK(8, 0)) | 7, d + 0x30);
+		writel(0x32, d + 0x34);
+		writel(readl(d + 0x40) & ~BIT(0), d + 0x40);
+		writel(0x1503, d + 0x64);
+		writel(0x33, d + 0x68);
+		writel(1, d);
