From 404d501220a5e9e21543e9766501fb88f821e111 Mon Sep 17 00:00:00 2001
From: r8s <r8s@localhost>
Date: Tue, 17 Nov 2026 07:16:54 -0300
Subject: [PATCH] soc: samsung: exynos990-cpu-wake: optional vendor PMU prep
 for deep suspend

Deep (mem) suspend never wakes on this port. The vendor 4.19 kernel does
three things before PSCI SYSTEM_SUSPEND that the port does not: it programs
the PMU system wake sources (WAKEUP_INT_EN 0x3944 / WAKEUP2_INT_EN 0x3964,
SYS_SLEEP column of the stock DT wakeup-masks), clears WAKEUP_STAT, and
writes CPU_INFORM = SLEEP (4) on the suspending CPU. The port instead leaves
the wake sources untouched and, through cpu_pm's syscore CPU_PM_ENTER,
writes CPU_INFORM = C2 on cpu0 right before the firmware call.

Add an off-by-default exynos990_cpu_wake.sleep_prep bitmask (bit0 wake
sources, bit1 SLEEP hint) that only acts in the syscore suspend path,
restores the previous INT_EN values on resume and logs WAKEUP_STAT.
Also expose psci.system_sleep_power_state so the vendor SYSTEM_SUSPEND call
can be tried without a new DTB (0 = SYSTEM_SUSPEND). Defaults are unchanged.

Based on GPL-2.0 Samsung code (drivers/soc/samsung/exynos-pm.c,
exynos-powermode.c, cal-if/exynos9830), LineageOS
android_kernel_samsung_universal9830 97369af7. Untested on the device.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/firmware/psci/psci.c             |  3 +
 drivers/soc/samsung/exynos990-cpu-wake.c | 72 +++++++++++++++++++++++-
 2 files changed, 74 insertions(+), 1 deletion(-)

diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index 57755e21b010..f6c49a4f803c 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -12,6 +12,7 @@
 #include <linux/debugfs.h>
 #include <linux/errno.h>
 #include <linux/linkage.h>
+#include <linux/moduleparam.h>
 #include <linux/of.h>
 #include <linux/pm.h>
 #include <linux/printk.h>
@@ -52,6 +53,8 @@ struct psci_operations psci_ops;
 
 /* platform CPU_SUSPEND power_state meaning "SoC sleep" (Samsung EL3); 0 = use SYSTEM_SUSPEND */
 static u32 psci_system_sleep_power_state;
+/* psci.system_sleep_power_state=0 falls back to SYSTEM_SUSPEND (what the vendor 4.19 kernel calls) */
+module_param_named(system_sleep_power_state, psci_system_sleep_power_state, uint, 0644);
 static enum arm_smccc_conduit psci_conduit = SMCCC_CONDUIT_NONE;
 
 bool psci_tos_resident_on(int cpu)
diff --git a/drivers/soc/samsung/exynos990-cpu-wake.c b/drivers/soc/samsung/exynos990-cpu-wake.c
index c3827ba49486..d7795827d978 100644
--- a/drivers/soc/samsung/exynos990-cpu-wake.c
+++ b/drivers/soc/samsung/exynos990-cpu-wake.c
@@ -36,11 +36,39 @@
 #include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
+#include <linux/syscore_ops.h>
 
 #define PMU_CPU_INFORM(n)	(0x0860 + 4 * (n))
 #define PMU_INT_EN_WAKE		BIT(3)
 #define INFORM_C1		0
 #define INFORM_C2		1
+#define INFORM_SLEEP		4	/* CPU_INFORM_SLEEP, flexpmu_cal_define_exynos9830.h */
+
+/*
+ * SoC-sleep wake sources (vendor exynos-powermode.c exynos_set_wakeupmask(),
+ * offsets and SYS_SLEEP masks from the stock exynos9830 DT "wakeup-masks").
+ * 0x81a6f = RTC/TRTC alarm+tick, CMGP EINT0/1, VTS mailbox+WDT, EINT, USB_REWA;
+ * 0x10 = AUD_ABOX_GIC400 (the USB L2 bits 2/3 are dropped as the vendor does
+ * with no OTG device attached).
+ */
+#define PMU_WAKEUP_INT_EN	0x3944
+#define PMU_WAKEUP2_INT_EN	0x3964
+#define PMU_WAKEUP_STAT		0x3950
+#define PMU_WAKEUP2_STAT	0x3954
+#define SLEEP_WAKEUP_INT_EN	0x00081a6f
+#define SLEEP_WAKEUP2_INT_EN	0x00000010
+
+/*
+ * Experimental, off by default: prepare the PMU for deep (mem) suspend the way
+ * the vendor exynos-pm syscore hook does. bit 0 = program the wake sources,
+ * bit 1 = tell the firmware SLEEP instead of C2 on the suspending CPU.
+ * Only the syscore (deep suspend) path reads it; s2idle and cpuidle never do.
+ */
+static uint sleep_prep;
+module_param(sleep_prep, uint, 0644);
+MODULE_PARM_DESC(sleep_prep, "deep suspend PMU prep: bit0 wake sources, bit1 SLEEP hint (default 0)");
+static uint sleep_prepped;
+static u32 saved_int_en, saved_int_en2;
 
 #define IGEN_GRP1_PEND		0x0108
 #define IGEN_GRP1_CLEAR		0x010c
@@ -83,7 +111,8 @@ static void cpu_wake_arm(unsigned int cpu)
 	if (cpu >= ARRAY_SIZE(int_en_off))
 		return;
 
-	regmap_write(pmu, PMU_CPU_INFORM(cpu), INFORM_C2);
+	regmap_write(pmu, PMU_CPU_INFORM(cpu),
+		     (sleep_prepped & BIT(1)) ? INFORM_SLEEP : INFORM_C2);
 
 	raw_spin_lock_irqsave(&igen_lock, flags);
 	v = readl_relaxed(igen + IGEN_GRP2_BID_ENABLE);
@@ -154,6 +183,45 @@ static struct notifier_block cpu_wake_pm_nb = {
 	.notifier_call = cpu_wake_pm_notify,
 };
 
+/*
+ * Registered after cpu_pm's own syscore hook, so this suspend callback runs
+ * before cpu_pm_suspend() sends CPU_PM_ENTER to cpu_wake_arm() on the boot CPU.
+ */
+static int cpu_wake_sys_suspend(void)
+{
+	sleep_prepped = sleep_prep;
+	if (!(sleep_prepped & BIT(0)))
+		return 0;
+
+	regmap_read(pmu, PMU_WAKEUP_INT_EN, &saved_int_en);
+	regmap_read(pmu, PMU_WAKEUP2_INT_EN, &saved_int_en2);
+	regmap_write(pmu, PMU_WAKEUP_STAT, 0);
+	regmap_write(pmu, PMU_WAKEUP2_STAT, 0);
+	regmap_write(pmu, PMU_WAKEUP_INT_EN, SLEEP_WAKEUP_INT_EN);
+	regmap_write(pmu, PMU_WAKEUP2_INT_EN, SLEEP_WAKEUP2_INT_EN);
+	return 0;
+}
+
+static void cpu_wake_sys_resume(void)
+{
+	u32 stat = 0, stat2 = 0;
+
+	if (sleep_prepped & BIT(0)) {
+		regmap_read(pmu, PMU_WAKEUP_STAT, &stat);
+		regmap_read(pmu, PMU_WAKEUP2_STAT, &stat2);
+		regmap_write(pmu, PMU_WAKEUP_INT_EN, saved_int_en);
+		regmap_write(pmu, PMU_WAKEUP2_INT_EN, saved_int_en2);
+		pr_info("exynos990-cpu-wake: WAKEUP_STAT 0x%08x 0x%08x (INT_EN was 0x%08x 0x%08x)\n",
+			stat, stat2, saved_int_en, saved_int_en2);
+	}
+	sleep_prepped = 0;
+}
+
+static struct syscore_ops cpu_wake_syscore_ops = {
+	.suspend = cpu_wake_sys_suspend,
+	.resume = cpu_wake_sys_resume,
+};
+
 static int exynos990_cpu_wake_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -179,6 +247,8 @@ static int exynos990_cpu_wake_probe(struct platform_device *pdev)
 		return ret;
 	}
 
+	register_syscore_ops(&cpu_wake_syscore_ops);
+
 	dev_info(dev, "PMU wake routing armed around CPU power-down\n");
 	return 0;
 }
-- 
2.56.1

