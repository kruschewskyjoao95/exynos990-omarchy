From: Antigravity <antigravity@local>
Subject: [PATCH] arm64: dts: exynos990: add s2mps22-acpm-regulator node

Expose the secondary S2MPS22 PMIC MIPI CSI-2 rails (LDO5S = 0.85V,
LDO6S = 1.8V) under the ACPM firmware node.

Signed-off-by: Antigravity <antigravity@local>
---
 arch/arm64/boot/dts/exynos/exynos990.dtsi | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos990.dtsi b/arch/arm64/boot/dts/exynos/exynos990.dtsi
index 000000000..000000000 100644
--- a/arch/arm64/boot/dts/exynos/exynos990.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos990.dtsi
@@ -359,6 +359,25 @@
 				samsung,power-domain = <&pd_g3d>;
 			};
 
+			acpm_s2mps22_regulators: regulators-s2mps22 {
+				compatible = "samsung,s2mps22-acpm-regulator";
+				acpm-ipc-channel = <2>;
+
+				regulators {
+					vdd_mipi_csi_0p85: ldo5s {
+						regulator-name = "VDD_MIPI_CSI_0P85_AP";
+						regulator-min-microvolt = <850000>;
+						regulator-max-microvolt = <850000>;
+					};
+
+					vdd_mipi_csi_1p8: ldo6s {
+						regulator-name = "VDD_MIPI_CSI_1P8_AP";
+						regulator-min-microvolt = <1800000>;
+						regulator-max-microvolt = <1800000>;
+					};
+				};
+			};
+
 			acpm_tmu: tmu {
 				compatible = "samsung,exynos990-acpm-tmu";
 				acpm-ipc-channel = <9>;
-- 
2.47.0
