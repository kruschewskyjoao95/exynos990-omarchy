From: Antigravity <antigravity@local>
Subject: [PATCH] arm64: dts: exynos990: add mipi_phy_csis0 node

Add the primary MIPI CSI-2 D-PHY node (mipi_phy_csis0 at 0x170d1300)
wired to pmu_system_controller and the S2MPS22 camera rails.

Signed-off-by: Antigravity <antigravity@local>
---
 arch/arm64/boot/dts/exynos/exynos990.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos990.dtsi b/arch/arm64/boot/dts/exynos/exynos990.dtsi
index 000000000..000000000 100644
--- a/arch/arm64/boot/dts/exynos/exynos990.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos990.dtsi
@@ -1091,6 +1091,16 @@
 		 */
 		clock-frequency = <26000000>;
 	};
+
+		mipi_phy_csis0: phy@170d1300 {
+			compatible = "samsung,mipi-phy-m0s4s4s4s4s4s2";
+			reg = <0x170d1300 0x500>;
+			samsung,pmu-syscon = <&pmu_system_controller>;
+			isolation = <0x730>;
+			vdd-0p85-supply = <&vdd_mipi_csi_0p85>;
+			vdd-1p8-supply = <&vdd_mipi_csi_1p8>;
+			#phy-cells = <1>;
+		};
 };
 
 #include "exynos990-pinctrl.dtsi"
