+	/*
+	 * The levels the Samsung kernel uses on this SoC (mali gpu_dvfs_table,
+	 * gpu_max_clock = 800 MHz; ECT also lists 832/897 MHz, left out).
+	 * No opp-microvolt: ACPM applies the ASV voltage with each rate.
+	 * opp-suspend mirrors Samsung's 9830 workaround (gpexwa_wakeup_clock):
+	 * drop to 377 MHz before the G3D domain powers off.
+	 */
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-156000000 {
+			opp-hz = /bits/ 64 <156000000>;
+		};
+		opp-260000000 {
+			opp-hz = /bits/ 64 <260000000>;
+		};
+		opp-377000000 {
+			opp-hz = /bits/ 64 <377000000>;
+			opp-suspend;
+		};
+		opp-455000000 {
+			opp-hz = /bits/ 64 <455000000>;
+		};
+		opp-572000000 {
+			opp-hz = /bits/ 64 <572000000>;
+		};
+		opp-702000000 {
+			opp-hz = /bits/ 64 <702000000>;
+		};
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+		};
+	};
+
