+MODULE_PARM_DESC(r8s_devfreq, "Enable devfreq (needs r8s_gpu_dvfs=1 on the kernel cmdline)");
+
 static void panfrost_devfreq_update_utilization(struct panfrost_devfreq *pfdevfreq)
 {
 	ktime_t now, last;
@@ -125,6 +129,10 @@ int panfrost_devfreq_init(struct panfrost_device *pfdev)
 	struct panfrost_devfreq *pfdevfreq = &pfdev->pfdevfreq;
 	unsigned long freq = ULONG_MAX;
 
+	/* r8s: G3D DVFS is unvalidated on hardware, keep the boot clock by default. */
+	if (!r8s_devfreq)
+		return 0;
+
 	if (pfdev->comp->num_supplies > 1) {
 		/*
 		 * GPUs with more than 1 supply require platform-specific handling:
