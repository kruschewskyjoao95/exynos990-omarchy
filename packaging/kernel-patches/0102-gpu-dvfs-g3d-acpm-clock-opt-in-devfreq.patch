diff --git a/drivers/clk/samsung/clk-exynos990-acpm-g3d.c b/drivers/clk/samsung/clk-exynos990-acpm-g3d.c
new file mode 100644
index 000000000000..756daf147800
--- /dev/null
+++ b/drivers/clk/samsung/clk-exynos990-acpm-g3d.c
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Exynos 990 GPU (G3D) clock over the ACPM DVFS channel (r8s).
+ *
+ * CMU_G3D is owned by the ACPM firmware: the Samsung kernel sets the GPU
+ * clock only through cal_dfs_set_rate(0x0B04000A), i.e. ACPM vclk index 10
+ * (acpm_dvfs_exynos9830.h: MIF=0 ... CP=9, G3D=10), and never touches a
+ * regulator for it - ACPM applies the ASV voltage itself, as it does for the
+ * CPU clusters (drivers/cpufreq/exynos990-cpufreq.c).
+ *
+ * Safety: nothing here talks to ACPM at probe. clk_set_rate() is refused
+ * unless the kernel was booted with r8s_gpu_dvfs=1, and is also refused while
+ * the G3D power domain is off (the Samsung driver never sets the GPU clock in
+ * that state). debugfs exynos990-g3d/status reads ACPM get_rate(10) on demand,
+ * only while the domain is on;
+ * exynos990-g3d/set_khz only exists with r8s_gpu_dvfs=1.
+ */
+#include <linux/clk.h>
+#include <linux/clk-provider.h>
+#include <linux/debugfs.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+#include <linux/seq_file.h>
+#include <linux/units.h>
+
+#define ACPM_DVFS_CHANNEL	5	/* same channel as exynos990-cpufreq */
+#define ACPM_DVFS_ID_G3D	10	/* Samsung DT g3d_cmu_cal_id = 0x0B04000A */
+#define PD_STATUS		0x4	/* pd_g3d status, bit 0 = on (exynos990_cfg) */
+
+static bool r8s_gpu_dvfs;
+core_param(r8s_gpu_dvfs, r8s_gpu_dvfs, bool, 0444);
+
+/* Levels the Samsung GPU driver uses on this unit (gpu_dvfs_table, max 800 MHz). */
+static const unsigned int g3d_khz[] = {
+	156000, 260000, 377000, 455000, 572000, 702000, 800000
+};
+
+struct g3d_clk {
+	struct clk_hw hw;
+	struct acpm_handle *acpm;
+	void __iomem *pd;
+	unsigned long cur_hz;	/* last rate ACPM accepted, else the old stub's 800 MHz */
+};
+
+#define to_g3d(_hw) container_of(_hw, struct g3d_clk, hw)
+
+static bool g3d_powered(struct g3d_clk *g3d)
+{
+	return g3d->pd && (readl_relaxed(g3d->pd + PD_STATUS) & 0x1);
+}
+
+static unsigned long g3d_recalc_rate(struct clk_hw *hw, unsigned long parent)
+{
+	return to_g3d(hw)->cur_hz;
+}
+
+/* Highest table level not above the request (never rounds up). */
+static int g3d_determine_rate(struct clk_hw *hw, struct clk_rate_request *req)
+{
+	int i;
+
+	for (i = ARRAY_SIZE(g3d_khz) - 1; i > 0; i--)
+		if ((unsigned long)g3d_khz[i] * HZ_PER_KHZ <= req->rate)
+			break;
+	req->rate = (unsigned long)g3d_khz[i] * HZ_PER_KHZ;
+	return 0;
+}
+
+static int g3d_set_rate(struct clk_hw *hw, unsigned long rate,
+			unsigned long parent)
+{
+	struct g3d_clk *g3d = to_g3d(hw);
+	int ret;
+
+	if (!r8s_gpu_dvfs) {
+		pr_warn_once("exynos990-g3d: DVFS off, boot with r8s_gpu_dvfs=1\n");
+		return -EPERM;
+	}
+	if (!g3d->acpm)
+		return -ENODEV;
+	if (!g3d_powered(g3d))
+		return -EAGAIN;
+
+	ret = g3d->acpm->ops->dvfs.set_rate(g3d->acpm, ACPM_DVFS_CHANNEL,
+					    ACPM_DVFS_ID_G3D, rate);
+	if (ret)
+		pr_warn_ratelimited("exynos990-g3d: %lu -> %lu kHz failed: %d\n",
+				    g3d->cur_hz / HZ_PER_KHZ, rate / HZ_PER_KHZ, ret);
+	else
+		g3d->cur_hz = rate;
+	return ret;
+}
+
+static const struct clk_ops g3d_clk_ops = {
+	.recalc_rate	= g3d_recalc_rate,
+	.determine_rate	= g3d_determine_rate,
+	.set_rate	= g3d_set_rate,
+};
+
+static int g3d_status_show(struct seq_file *s, void *unused)
+{
+	struct g3d_clk *g3d = s->private;
+	bool on = g3d_powered(g3d), in_table = false;
+	unsigned long khz;
+	int i;
+
+	seq_printf(s, "pd_g3d: %s\n", on ? "on" : "off");
+	seq_printf(s, "r8s_gpu_dvfs: %d\n", r8s_gpu_dvfs);
+	seq_printf(s, "last_set_khz: %lu\n", g3d->cur_hz / HZ_PER_KHZ);
+	/* Samsung only queries the G3D clock while the domain is on; so do we. */
+	if (!on || !g3d->acpm) {
+		seq_puts(s, "acpm_khz: skipped (pd_g3d off or no ACPM)\n");
+		return 0;
+	}
+	khz = g3d->acpm->ops->dvfs.get_rate(g3d->acpm, ACPM_DVFS_CHANNEL,
+					    ACPM_DVFS_ID_G3D) / HZ_PER_KHZ;
+	for (i = 0; i < ARRAY_SIZE(g3d_khz); i++)
+		in_table |= khz == g3d_khz[i];
+	seq_printf(s, "acpm_khz: %lu%s\n", khz, in_table ? "" : " (not a table level)");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(g3d_status);
+
+/* Goes through the clk core, so the table check and the power check apply. */
+static int g3d_set_khz(void *data, u64 val)
+{
+	struct g3d_clk *g3d = data;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(g3d_khz); i++)
+		if (val == g3d_khz[i])
+			return clk_set_rate(g3d->hw.clk, val * HZ_PER_KHZ);
+	return -EINVAL;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(g3d_set_khz_fops, NULL, g3d_set_khz, "%llu\n");
+
+static int g3d_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct device_node *np;
+	struct resource res;
+	struct g3d_clk *g3d;
+	struct dentry *dir;
+	int ret;
+
+	g3d = devm_kzalloc(dev, sizeof(*g3d), GFP_KERNEL);
+	if (!g3d)
+		return -ENOMEM;
+
+	np = of_get_parent(dev->of_node);
+	g3d->acpm = devm_acpm_get_by_node(dev, np);
+	of_node_put(np);
+	/* Never leave panfrost without a clock: fall back to a fixed one. */
+	if (IS_ERR(g3d->acpm)) {
+		if (PTR_ERR(g3d->acpm) == -EPROBE_DEFER)
+			return -EPROBE_DEFER;
+		dev_warn(dev, "no ACPM handle (%pe), G3D clock fixed\n", g3d->acpm);
+		g3d->acpm = NULL;
+	}
+	g3d->cur_hz = 800 * HZ_PER_MHZ;
+
+	/*
+	 * Read-only peek at the pd_g3d status register. The pd driver owns the
+	 * region, so map it without requesting it.
+	 */
+	np = of_parse_phandle(dev->of_node, "samsung,power-domain", 0);
+	ret = np ? of_address_to_resource(np, 0, &res) : -ENODEV;
+	of_node_put(np);
+	if (ret)
+		dev_warn(dev, "no samsung,power-domain (%d), rate changes off\n", ret);
+	else
+		g3d->pd = devm_ioremap(dev, res.start, resource_size(&res));
+
+	g3d->hw.init = CLK_HW_INIT_NO_PARENT("g3d_acpm", &g3d_clk_ops,
+					     CLK_GET_RATE_NOCACHE);
+	ret = devm_clk_hw_register(dev, &g3d->hw);
+	if (ret)
+		return ret;
+	ret = devm_of_clk_add_hw_provider(dev, of_clk_hw_simple_get, &g3d->hw);
+	if (ret)
+		return ret;
+
+	dir = debugfs_create_dir("exynos990-g3d", NULL);
+	debugfs_create_file("status", 0444, dir, g3d, &g3d_status_fops);
+	if (r8s_gpu_dvfs)
+		debugfs_create_file_unsafe("set_khz", 0200, dir, g3d,
+					   &g3d_set_khz_fops);
+
+	dev_info(dev, "G3D clock via ACPM id %d, DVFS %s\n", ACPM_DVFS_ID_G3D,
+		 r8s_gpu_dvfs ? "ENABLED (r8s_gpu_dvfs=1)" : "off");
+	return 0;
+}
+
+static const struct of_device_id g3d_clk_of_match[] = {
+	{ .compatible = "samsung,exynos990-acpm-g3d-clk" },
+	{ }
+};
+
+static struct platform_driver g3d_clk_driver = {
+	.probe	= g3d_clk_probe,
+	.driver	= {
+		.name = "exynos990-acpm-g3d-clk",
+		.of_match_table = g3d_clk_of_match,
+		.suppress_bind_attrs = true,	/* debugfs dir is never removed */
+	},
+};
+builtin_platform_driver(g3d_clk_driver);
