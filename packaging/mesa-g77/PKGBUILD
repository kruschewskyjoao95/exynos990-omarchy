prepare() {
  cd "${srcdir}/mesa"
  local p
  for p in "${_patches[@]}"; do
    msg2 "Applying ${p}"
    patch -Np1 -i "${srcdir}/${p}"
  done
}

build() {
  local meson_options=(
    --prefix=/opt/mesa-g77
    --libdir=lib
    --buildtype=release
    -Db_ndebug=true
    -Dgallium-drivers=panfrost
    -Dvulkan-drivers=panfrost
    -Dglx=dri
    -Degl=enabled
    -Dgbm=enabled
    -Dopengl=true
    -Dgles1=disabled
    -Dgles2=enabled
    -Dglvnd=enabled
    -Dplatforms=wayland,x11
    -Dllvm=enabled
    -Dshared-llvm=enabled
    -Dvideo-codecs=
    -Dtools=
    -Ddisplay-info=enabled
    -Dvalgrind=disabled
    -Dlibunwind=disabled
    -Dlmsensors=disabled
    -Dxlib-lease=disabled
    -Dvulkan-manifest-per-architecture=true
  )

  meson setup "${srcdir}/mesa" "${srcdir}/build" "${meson_options[@]}"
  meson compile -C "${srcdir}/build"
}

package() {
  meson install -C "${srcdir}/build" --destdir "${pkgdir}" --no-rebuild

  install -Dm0755 "${srcdir}/mesa-g77-run" "${pkgdir}/opt/mesa-g77/bin/mesa-g77-run"
  install -Dm0644 "${srcdir}/r8s-mesa-g77.sh" "${pkgdir}/etc/profile.d/r8s-mesa-g77.sh"
  install -Dm0644 "${srcdir}/90-r8s-mesa-g77.conf" "${pkgdir}/etc/environment.d/90-r8s-mesa-g77.conf"
  install -Dm0644 "${srcdir}/20-r8s-mesa-g77.conf" \
    "${pkgdir}/usr/lib/systemd/system/sddm.service.d/20-r8s-mesa-g77.conf"
  install -Dm0644 "${srcdir}/mesa/docs/license.rst" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
