# Maintainer: linuxs20fe (r8s / SM-G780F / Exynos 990)
# Reproducible side-by-side Mesa 26.3.0-devel (Panfrost + PanVK Valhall v9)
# installed under /opt/mesa-g77 so stock Arch ARM extra/mesa remains intact
# to satisfy desktop package SONAMEs without breaking pacman.

pkgname=mesa-g77
_commit='7d6bb09d5b59ec5af1a58971f34390a62943bfe0'
pkgver=26.3.0_devel.7d6bb09d
pkgrel=2
pkgdesc='Mesa 26.3.0-devel Panfrost + PanVK (Mali-G77 / Valhall v9) side-by-side build in /opt/mesa-g77'
arch=('aarch64')
url='https://gitlab.freedesktop.org/mesa/mesa'
license=('MIT AND BSD-3-Clause AND SGI-B-2.0')

# Runtime dependencies checked against manifests/packages-aarch64.md and
# manifests/packages-aarch64-stable.tsv (plus llvm-libs & libelf from meson.build).
# Note: intentionally does NOT provide/conflict with extra/mesa so Hyprland,
# Quickshell, Qt6, and libglvnd dependencies remain satisfied by stock packages.
depends=(
  'expat'
  'gcc-libs'
  'glibc'
  'libdisplay-info'
  'libdrm'
  'libelf'
  'libglvnd'
  'libx11'
