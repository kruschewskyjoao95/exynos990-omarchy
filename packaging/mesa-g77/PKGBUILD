  'libxext'
  'libxfixes'
  'libxshmfence'
  'libxxf86vm'
  'llvm-libs'
  'spirv-tools'
  'systemd-libs'
  'wayland'
  'zlib'
  'zstd'
)

makedepends=(
  'bison'
  'clang'
  'flex'
  'git'
  'llvm'
  'meson'
  'ninja'
  'pkgconf'
  'python'
  'python-mako'
  'python-packaging'
  'python-ply'
  'python-yaml'
  'spirv-llvm-translator'
  'spirv-tools'
  'wayland-protocols'
  'xorgproto'
)

optdepends=(
  'vulkan-tools: vulkaninfo verification with PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1'
  'mesa-utils: eglinfo / glxinfo verification (must report Mali-G77 (Panfrost))'
)

options=('!lto')

_patches=(
  '0001-panvk-baseline-Valhall-v9-Mali-G77-JM-enablement-fro.patch'
  '0002-vulkan-runtime-add-a-compute-shader-BCn-BC1-BC5-deco.patch'
  '0003-panvk-gate-and-advertise-BCn-emulation-PANVK_BC_EMUL.patch'
  '0004-panvk-back-BC-emulated-images-with-a-raw-block-plane.patch'
  '0005-panvk-decode-BC-blocks-with-a-compute-dispatch-after.patch'
  '0006-vulkan-runtime-pin-the-BCn-decoder-arithmetic-to-the.patch'
  '0007-panvk-add-a-PANVK_DXVK_COMPAT-gate-and-advertise-the.patch'
  '0008-panvk-implement-shaderClipDistance-on-v9-as-a-fragme.patch'
  '0009-panvk-enable-VK_KHR-EXT_robustness2-on-v9-under-PANV.patch'
  '0010-panfrost-bifrost-lower-ubfe-ibfe-in-NIR.patch'
  '0011-panfrost-bifrost-test-the-ubfe-ibfe-lowering-against.patch'
  '0012-compiler-glsl-add-BC7-and-BC6H-compute-decoders-from.patch'
  '0013-vulkan-runtime-decode-BC7-and-BC6H-in-vk_texcompress.patch'
  '0014-vulkan-runtime-pin-the-BC7-BC6H-decoders-to-the-CPU-.patch'
  '0015-panvk-dispatch-the-BC7-BC6H-decode-pipelines-add-PAN.patch'
)

_mesa_git_url="${MESA_G77_GIT_URL:-https://gitlab.freedesktop.org/mesa/mesa.git}"

source=(
  "mesa::git+${_mesa_git_url}#commit=${_commit}"
  "${_patches[@]}"
  'r8s-mesa-g77.sh'
  '90-r8s-mesa-g77.conf'
  'mesa-g77-run'
  '20-r8s-mesa-g77.conf'
)

